{
  "name": "iris-creation",
  "private": true,
  "version": "0.0.2-test.1",
  "type": "module",
  "scripts": {
    "sync:branding": "node ./scripts/sync-branding.mjs",
    "predev": "node ./scripts/sync-branding.mjs",
    "prebuild": "node ./scripts/sync-branding.mjs",
    "dev": "pnpm --dir webui dev",
    "build": "pnpm --dir webui build",
    "lint": "pnpm --dir webui exec tsc -b tsconfig.json --noEmit",
    "preview": "pnpm --dir webui preview",
    "test": "pnpm --dir webui exec vitest --run",
    "test:watch": "pnpm --dir webui exec vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-build.ps1",
    "clean:full": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-build.ps1 && pnpm install --frozen-lockfile",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "release:sh": "bash ./scripts/release.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
