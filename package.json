{
  "name": "novel-ide",
  "private": true,
  "version": "0.0.2-test.1",
  "type": "module",
  "scripts": {
    "sync:branding": "node ./scripts/sync-branding.mjs",
    "predev": "node ./scripts/sync-branding.mjs",
    "prebuild": "node ./scripts/sync-branding.mjs",
    "dev": "vite --config src-react/vite.config.ts --port 1420 --strictPort",
    "build": "tsc -b src-react/tsconfig.json && vite build --config src-react/vite.config.ts",
    "lint": "eslint -c src-react/eslint.config.js --no-error-on-unmatched-pattern --quiet src-react/src src-react/__tests__",
    "preview": "vite preview --config src-react/vite.config.ts",
    "test": "vitest --config src-react/vitest.config.ts --run",
    "test:watch": "vitest --config src-react/vitest.config.ts",
    "test:ui": "vitest --config src-react/vitest.config.ts --ui",
    "test:run": "vitest --config src-react/vitest.config.ts run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-build.ps1",
    "clean:full": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-build.ps1 && pnpm install --frozen-lockfile",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "release:sh": "bash ./scripts/release.sh"
  },
  "dependencies": {
    "@lexical/code": "^0.40.0",
    "@lexical/history": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/plain-text": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "dompurify": "^3.1.7",
    "fast-diff": "^1.3.0",
    "lexical": "^0.40.0",
    "lucide-react": "^0.575.0",
    "marked": "^15.0.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fast-diff": "^1.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
