{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris-Creation",
  "version": "0.0.2-test.1",
  "identifier": "com.iris-creation.app",
  "build": {
    "beforeDevCommand": "pnpm --dir webui dev",
    "beforeBuildCommand": "pnpm --dir webui build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../webui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iris-Creation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
